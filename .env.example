# =========================================================================
# ecommerce-conversion-prediction - environment variables
# Copy to .env (gitignored, NEVER committed).
# =========================================================================
# Kaggle download of the DMC 2013 dataset is usually anonymous; if kagglehub
# asks you to authenticate, create a token at kaggle.com/settings/account.
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_api_key
# Override the data path if you placed it yourself:
# DMC2013_DATA=/abs/path/to/transact_train.txt
LOG_LEVEL=INFO
RANDOM_SEED=42
